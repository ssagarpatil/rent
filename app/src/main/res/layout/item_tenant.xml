<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Icon for Tenant Type -->
        <ImageView
            android:id="@+id/ivTenantIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_people"
            tools:src="@drawable/ic_people"
            android:background="@drawable/circular_background"
            android:padding="8dp"
            app:tint="@android:color/white"
            />

        <!-- Tenant Name and Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvTenantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Shubham Mali"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTenantDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Mobile: 8659659659"
                android:textSize="14sp"
                android:textColor="#555555"/>
        </LinearLayout>

        <!-- Options Menu (three dots) -->
        <ImageView
            android:id="@+id/ivTenantOptions"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_more_vert"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Options"
            app:tint="#666666"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

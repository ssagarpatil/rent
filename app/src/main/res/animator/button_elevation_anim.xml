<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <objectAnimator
            android:duration="120"
            android:propertyName="translationZ"
            android:valueTo="10"
            android:valueType="floatType"/>
    </item>
    <item>
        <objectAnimator
            android:duration="120"
            android:propertyName="translationZ"
            android:valueTo="4"
            android:valueType="floatType"/>
    </item>
</selector>
